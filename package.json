{
  "name": "gcode-sender",
  "productName": "GCode Sender",
  "version": "2.0.0",
  "description": "A modern cross-platform G-code sender and temperature-control workstation",
  "homepage": "https://github.com/Zergie/gcode_sender",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:debug": "concurrently --kill-others-on-fail \"npm:dev:renderer\" \"npm:dev:electron:debug\"",
    "dev:renderer": "ng serve --host 127.0.0.1 --port 4200",
    "dev:electron": "npm run build:electron && wait-on http://127.0.0.1:4200 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:4200 electron .",
    "dev:electron:debug": "npm run build:electron && wait-on http://127.0.0.1:4200 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:4200 electron --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 .",
    "clean": "node scripts/clean-build.mjs all",
    "clean:renderer": "node scripts/clean-build.mjs renderer",
    "clean:electron": "node scripts/clean-build.mjs electron",
    "clean:package": "node scripts/clean-build.mjs package",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "npm run clean:renderer && ng build && node scripts/check-style-contract.mjs",
    "build:electron": "npm run clean:electron && tsc --project tsconfig.electron.json",
    "test": "npm run test:renderer && npm run test:backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "prepackage": "npm run clean:package",
    "premake": "npm run clean:package",
    "start": "npm run dev",
    "test:renderer": "ng test --watch=false",
    "test:backend": "vitest run shared electron --exclude \"src/**\"",
    "test:firmware-integration": "cross-env RUN_FIRMWARE_WASM_INTEGRATION=1 vitest run electron/firmware/firmware-build.integration.spec.ts",
    "test:browser": "playwright test",
    "check:route-styles": "node scripts/check-migrated-route-styles.mjs about dashboard terminal jobs settings simulation tuning",
    "check:style-contract": "node scripts/check-style-contract.mjs",
    "verify:windows-dev-icon": "npm run build:electron && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-dev-icon.ps1",
    "verify:windows-package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-package.ps1",
    "verify:archive-security": "node scripts/archive-security-gate.mjs --lockfile package-lock.json --policy scripts/archive-security-policy.json --exceptions scripts/archive-security-exceptions.json",
    "rebuild:native": "electron-rebuild",
    "postinstall": "electron-rebuild"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zergie/gcode_sender.git"
  },
  "author": "Wolfgang Puchinger",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Zergie/gcode_sender/issues"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "chart.js": "^4.5.0",
    "electron-log": "^5.4.3",
    "rxjs": "^7.8.2",
    "serialport": "^13.0.0",
    "three": "^0.180.0",
    "tslib": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.0",
    "@types/three": "^0.180.0",
    "angular-eslint": "^22.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "30.0.1",
    "prettier": "^3.7.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "overrides": {
    "@electron-forge/core-utils": {
      "@electron/rebuild": {
        "tar": "6.2.1"
      }
    },
    "@electron-forge/core": {
      "@electron/rebuild": {
        "tar": "6.2.1"
      }
    },
    "@electron-forge/shared-types": {
      "@electron/rebuild": {
        "tar": "6.2.1"
      }
    }
  }
}
