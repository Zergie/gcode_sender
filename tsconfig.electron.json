{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "lib": ["ES2022"],
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts"],
  "exclude": ["electron/**/*.spec.ts", "shared/**/*.spec.ts"]
}
