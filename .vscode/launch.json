{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Electron v2",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/electron/main.js",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd",
      "preLaunchTask": "npm: build",
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
